NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Enable Geocoding API and Routes API; restrict this key to those APIs.
GOOGLE_MAPS_SERVER_API_KEY=
LYSTO_ROUTING_ORIGIN=Obelisco, Ciudad Autónoma de Buenos Aires, Argentina

PAYMENTS_PROVIDER=mock
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MARKETPLACE_CLIENT_ID=
MERCADOPAGO_MARKETPLACE_CLIENT_SECRET=
# Use mercadopago_split to enable checkout; test requires OAuth TEST tokens.
MERCADOPAGO_MODE=test
# Server-only PostgreSQL URI for the SAME Supabase database, direct/session pool.
# This role must have access to private payment tables; never expose to clients.
MERCADOPAGO_DATABASE_URL=
# Base64-encoded 32 random bytes. Keep stable and backed up to decrypt OAuth tokens.
MERCADOPAGO_ENCRYPTION_KEY=

NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=

WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

AI_ENABLED=false
AI_PROVIDER=
OPENAI_API_KEY=
