{
  "name": "lysto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types tests/run-domain-tests.ts",
    "test:unit": "vitest run",
    "test": "node --experimental-strip-types tests/run-domain-tests.ts && vitest run",
    "test:e2e": "playwright test",
    "test:ci": "eslint . --max-warnings=0 && tsc --noEmit && node --experimental-strip-types tests/run-domain-tests.ts && vitest run && next build"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^0.0.24",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@waltergaltieri/mercadopago-split": "file:vendor/waltergaltieri-mercadopago-split-0.1.0.tgz",
    "lucide-react": "^0.468.0",
    "mercadopago": "^2.0.15",
    "next": "^15.4.0",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
